<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Emby.Plugins.WatchTogether</RootNamespace>
    <AssemblyName>Emby.Plugins.WatchTogether</AssemblyName>
    <Version>1.4.2.0</Version>
    <FileVersion>1.4.2.0</FileVersion>
    <AssemblyVersion>1.4.2.0</AssemblyVersion>
    <Description>Emby server plugin for two-person synchronized watching (Watch Together).</Description>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.0.52-beta" />
    <PackageReference Include="System.Memory" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\Configuration\watchtogether.html">
      <LogicalName>Emby.Plugins.WatchTogether.Configuration.watchtogether.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Web\Configuration\watchtogether.js">
      <LogicalName>Emby.Plugins.WatchTogether.Configuration.WatchTogether.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
